# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.
# On Runflare, set these same keys in the dashboard's environment variables instead.

# --- Email (Gmail SMTP) ---
# Leave EMAIL_BACKEND unset to use the console backend (prints emails to the log).
# To actually send via Gmail, you need an App Password:
#   1. Enable 2-Step Verification at myaccount.google.com
#   2. Generate an App Password at myaccount.google.com/apppasswords
#   3. Paste the 16-char password (no spaces) into EMAIL_HOST_PASSWORD below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
#the account that sends.
EMAIL_HOST_USER=aria.test.py@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword
DEFAULT_FROM_EMAIL=aramesh.music.acad@gmail.com
#inbox that receives
CONTACT_NOTIFICATION_EMAIL=aramesh.music.acad@gmail.com

# --- About page ---
# Slug of the gallery page whose images appear in the "فضای آموزشگاه" section on the About page.
ABOUT_GALLERY_SLUG=academy-space

# --- Security ---
# Required whenever DEBUG is False: the site refuses to start without it.
# Only with DEBUG=True does it fall back to a development key.
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# With DEBUG=False the site is https only: secure cookies, and http requests redirect to https.
DEBUG=False
# Leave unset in production. Set to False only to run with DEBUG=False over plain http,
# for example checking production mode on localhost, or if a platform health check gets redirected.
# SECURE_SSL_REDIRECT=False
# Hosts Django will answer on: comma-separated, no scheme or port.
# Leave unset to use the defaults in settings.py (the five hosts below).
# Locally, localhost,127.0.0.1 is enough.
ALLOWED_HOSTS=aramesh-academy.ir,aramesh-academy.runflare.run,api.runflare.com,localhost,127.0.0.1
# Origins allowed to post forms (contact form, admin login): comma-separated, with https://.
# Every https host in ALLOWED_HOSTS that serves forms belongs here too. Leave unset for the defaults below.
CSRF_TRUSTED_ORIGINS=https://aramesh-academy.ir,https://aramesh-academy.runflare.run

# --- Site ---
# The public domain that canonical links, link previews (og:url, og:image) and sitemap.xml name,
# whichever host served the page. No scheme. Leave unset for aramesh-academy.ir.
SITE_DOMAIN=aramesh-academy.ir

# --- Database ---
# Where the SQLite file lives: relative to the project folder, or an absolute path
# (for example a persistent disk on Runflare). Leave unset for database/db.sqlite3.
DATABASE_PATH=database/db.sqlite3

# --- Social media (optional) ---
# Leave unset to use the defaults in settings.py; set to an empty value to hide the link.
# SITE_INSTAGRAM=https://www.instagram.com/arameshmusic.academy/
# SITE_TELEGRAM=https://t.me/arameshmusicacademyconcert

# --- Analytics ---
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
GOOGLE_ANALYTICS_ID=
